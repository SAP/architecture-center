        <mxCell id="bdc-l3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#0063D9;fillColor=#3685EF;strokeWidth=1;fontFamily=Arial;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;" value="&lt;p style=&quot;margin: 0px; color: rgb(255, 255, 255); font-size: 12px;&quot;&gt;&lt;b&gt;ML (Prediction &amp;amp; Anomaly Detection)&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin: 4px 0px 0px; color: rgb(255, 255, 255); font-size: 10px; line-height: 1.5;&quot;&gt;Tabular foundation models, apply one rather than engineer a pipeline&lt;/p&gt;" vertex="1">
          <mxGeometry height="88" width="440" x="658" y="362" as="geometry" />
