        <mxCell id="bdc-l2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#0063D9;fillColor=#2A79E3;strokeWidth=1;fontFamily=Arial;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;" value="&lt;p style=&quot;margin: 0px; color: rgb(255, 255, 255); font-size: 12px;&quot;&gt;&lt;b&gt;MDM (Master Data Management)&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin: 4px 0px 0px; color: rgb(255, 255, 255); font-size: 10px; line-height: 1.5;&quot;&gt;Managed capability (Reltio), configure it rather than construct it&lt;/p&gt;" vertex="1">
