        <mxCell id="diy-side-label" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=none;fillColor=#6A7A8C;arcSize=16;absoluteArcSize=1;fontSize=11;fontFamily=Arial;fontColor=#ffffff;" value="&lt;b style=&quot;color: rgb(255, 255, 255);&quot;&gt;DIY on an external lakehouse&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(255, 255, 255);&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(255, 255, 255);&quot;&gt;You build, operate &amp;amp; govern all of this&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="93.65" width="434" x="90" y="-28.65" as="geometry" />
