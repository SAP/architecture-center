        <mxCell id="bdc-l1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#0063D9;fillColor=#1E6AD4;strokeWidth=1;fontFamily=Arial;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;" value="&lt;p style=&quot;margin: 0px; color: rgb(255, 255, 255); font-size: 12px;&quot;&gt;&lt;b&gt;ETL (SAP + non-SAP sources)&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin: 4px 0px 0px; color: rgb(255, 255, 255); font-size: 10px; line-height: 1.5;&quot;&gt;Governed Data Products with stable, versioned contracts; SAP absorbs the release churn&lt;/p&gt;" vertex="1">
