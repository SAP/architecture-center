# Root lifecycle scripts are allowed (ignore-scripts=false). The repo's own
# pre/postinstall hooks and a few native-binding dependencies (fsevents,
# unrs-resolver, core-js) rely on them; disabling scripts globally would break
# local installs and the dev workflow.
#
# Transitive dependency install scripts are controlled separately from this flag:
#   - On npm >= 12 they are DENIED BY DEFAULT. Only packages listed in the
#     "allowScripts" field of package.json may run install (pre/post/prepare)
#     scripts, and that list has been reviewed. Any newly added dependency with an
#     install script is skipped and reported until a maintainer reviews it and
#     runs `npm install-scripts approve <pkg>`.
#   - On older npm (no allowScripts support) transitive install scripts still run
#     at install time. There the risk is reduced, not eliminated, by the committed
#     package-lock.json (so any dependency change is visible in PR review) and the
#     dependency-review action on pull requests. This residual is accepted.
#
# Note: the Security Audit workflow's script scan only inspects the ROOT
# package.json scripts, not transitive dependency install scripts, so it is not a
# control for the risk described above.
ignore-scripts=false
