# Lifecycle (pre/postinstall) scripts are intentionally ALLOWED (ignore-scripts=false).
# Several toolchain dependencies (e.g. fsevents, native resolvers, core-js) rely on
# install scripts to build or fetch native bindings; disabling them globally would
# break local `npm install` and the dev workflow.
#
# Supply-chain hardening is handled by other means instead:
#   - a committed package-lock.json and `npm ci` in CI (reproducible installs)
#   - SHA-pinned GitHub Actions and least-privilege workflow permissions
#   - the Security Audit workflow (npm audit + dangerous-script scanning)
ignore-scripts=false
