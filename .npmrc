# Lifecycle (install) scripts are ENABLED (npm default) because the dependency
# tree contains native modules — e.g. @parcel/watcher, fsevents, unrs-resolver —
# that must run node-gyp/postinstall builds to work locally and in CI.
# NOTE: ignore-scripts=false does NOT provide supply-chain protection; it is the
# permissive default. Any script hardening must come from pinned, reviewed
# dependencies and lockfile integrity (npm ci), not from this flag.
ignore-scripts=false

# For a locked-down environment you can opt into blocking scripts per-invocation
# instead of globally, e.g.: npm ci --ignore-scripts
