{
  "version": "0.2",
  "language": "en,en-US,en-GB",
  "dictionaryDefinitions": [
    { "name": "sap", "path": ".cspell/sap.txt", "addWords": true },
    { "name": "industry", "path": ".cspell/industry.txt", "addWords": true },
    { "name": "partners", "path": ".cspell/partners.txt", "addWords": true },
    { "name": "people", "path": ".cspell/people.txt", "addWords": true }
  ],
  "dictionaries": ["sap", "industry", "partners", "people"],
  "words": ["RAXXXX", "claudeignore"],
  "ignoreRegExpList": [
    "Urls",
    "Email",
    "HexValues",
    "FrontMatterTags",
    "FrontMatterContributors",
    "FrontMatterAuthor"
  ],
  "patterns": [
    {
      "name": "FrontMatterTags",
      "pattern": "/^tags:[^\\n]*\\n(?:[ \\t]+-[^\\n]*\\n)*/gm"
    },
    {
      "name": "FrontMatterContributors",
      "pattern": "/^contributors:[^\\n]*\\n(?:[ \\t]+-[^\\n]*\\n)*/gm"
    },
    {
      "name": "FrontMatterAuthor",
      "pattern": "/^[ \\t]*author:[^\\n]*$/gm"
    }
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/*.drawio",
    "**/*.svg",
    "**/*.png",
    "**/*.jpg",
    "**/*.jpeg",
    "**/*.gif",
    "docs/ref-arch/RA0000/**",
    "docs/community/99-cookie-and-privacy/**",
    "docs/community/10-the-team.md"
  ],
  "files": ["docs/**/*.md", "docs/**/*.mdx", "news/**/*.md", "news/**/*.mdx"]
}
